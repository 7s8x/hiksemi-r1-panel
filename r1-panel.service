[Unit]
Description=HIKSEMI R1 touch status panel
After=local-fs.target systemd-logind.service r1-fan-curve.service r1-collector.service
ConditionPathExists=/dev/fb0
StartLimitIntervalSec=300
StartLimitBurst=3

Wants=r1-collector.service

[Service]
Type=simple
RuntimeDirectory=r1-panel
RuntimeDirectoryMode=0700
ExecStartPre=/bin/sh /root/r1-screen/r1_panel_preflight.sh
ExecStart=/root/r1-screen/.venv/bin/python /root/r1-screen/r1_panel_next.py --touch --initial-view fans
ExecStopPost=-/bin/sh /root/r1-screen/r1_panel_restore_tty.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
